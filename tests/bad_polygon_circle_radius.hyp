application "Bad Polygon Circle Radius" is game

model Shape
    field name is text
end

controller Main
    when application starts
        show view "main"
    end

    when game updates
        check whether polygon through 0 0 then 20 0 then 10 20 touches circle centered at 10 10 with radius -1 as touching
    end
end

view "main"
    draw polygon through 0 0 then 20 0 then 10 20 with color 255 255 255
end
