application "Bad Polygon Rectangle Size" is game

model Shape
    field name is text
end

controller Main
    when application starts
        show view "main"
    end

    when game updates
        check whether rectangle at 5 5 sized -1 by 4 touches polygon through 0 0 then 20 0 then 10 20 as touching
    end
end

view "main"
    draw polygon through 0 0 then 20 0 then 10 20 with color 255 255 255
end
