application "Bad Line Rectangle Size" is game

model Shape
    field name is text
end

controller Main
    when application starts
        show view "main"
    end

    when game updates
        check whether rectangle at 5 5 sized -1 by 4 touches line from 0 0 to 10 10 as touching
    end
end

view "main"
    draw line from 0 0 to 10 10 with color 255 255 255
end
