application "Bad Line Circle Radius" is game

model Shape
    field name is text
end

controller Main
    when application starts
        show view "main"
    end

    when game updates
        check whether line from 0 0 to 10 10 touches circle centered at 5 5 with radius -1 as touching
    end
end

view "main"
    draw line from 0 0 to 10 10 with color 255 255 255
end
