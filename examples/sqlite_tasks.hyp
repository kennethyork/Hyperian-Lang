application "SQLite Tasks" is web
data version 2
store data in sqlite file "sqlite-tasks.db"
listen on 8086

when data changes from 1 to 2
    rename field title to name in model Task
end

model Task
    field name is text required
end

controller Tasks
    when someone visits "/"
        find all Task as tasks
        show view "tasks" with tasks
    end

    when someone submits "/tasks"
        create Task from form
        redirect to "/"
    end
end

view "tasks"
    heading "SQLite tasks"
    form posts to "/tasks"
        input "Task name" as name required
        button "Add task"
    end
    for each task in tasks show
        show task.name
    end
end
